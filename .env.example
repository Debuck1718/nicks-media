# Copy to .env (local) and set the same names in
# Vercel > Project > Settings > Environment Variables (Production + Preview).
#
# .env is gitignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# CMS — Sanity. This is where editors write and publish stories.
# ---------------------------------------------------------------------------
# Public, non-secret values. Prefixed PUBLIC_ so Astro inlines them at build time.
PUBLIC_SANITY_PROJECT_ID=cgcw2i33
PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Draft preview — lets an editor see an UNPUBLISHED story on the real site
# ---------------------------------------------------------------------------
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The Studio opens /api/preview?slug=<slug>&secret=<this value>.
PREVIEW_SECRET=replace_with_a_long_random_string

# Read token with "View drafts" permission, used only by the build and the
# preview route so they can read unpublished documents.
# Create at sanity.io/manage > Evantra > API > Tokens (permission: Viewer).
# Set this in Vercel and in your local .env — NEVER here, and NEVER with a
# PUBLIC_ prefix (Astro would inline it into the browser bundle).
SANITY_API_READ_TOKEN=sk_replace_with_your_viewer_token

# ---------------------------------------------------------------------------
# Report intake — outsider tips are emailed to the newsroom.
# Used by api/reports.js on Vercel
# ---------------------------------------------------------------------------

# Newsroom inbox that receives submitted reports.
INTAKE_TO_EMAIL=hello@nicksmedia.com

# Verified sender address. The domain MUST be verified in Resend, or delivery
# will fail with a 403.
# https://resend.com/docs/dashboard/domains/introduction
INTAKE_FROM_EMAIL=newsroom@nicksmedia.com

# Resend API key (starts with "re_"). https://resend.com/api-keys
RESEND_API_KEY=re_replace_me

# ---------------------------------------------------------------------------
# Studio build only — the Studio is deployed as its own Vercel project.
# These are read at Studio BUILD time, not runtime.
# ---------------------------------------------------------------------------
# SANITY_STUDIO_PROJECT_ID=your_project_id
# SANITY_STUDIO_DATASET=production
# Where the "Preview" button should point.
SANITY_STUDIO_PREVIEW_URL=https://nicks-media-red.vercel.app
# Must match PREVIEW_SECRET above, or Preview returns 401.
# SANITY_STUDIO_PREVIEW_SECRET=replace_with_a_long_random_string