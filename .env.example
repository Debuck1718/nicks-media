# Copy to .env (local) and set the same names in
# Vercel > Project > Settings > Environment Variables (production).
#
# .env is gitignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Report intake — used by api/reports.js on Vercel
# ---------------------------------------------------------------------------

# Newsroom inbox that receives submitted reports.
INTAKE_TO_EMAIL=hello@nicksmedia.com

# Verified sender address. The domain MUST be verified in Resend, or delivery
# will fail with a 403.
# https://resend.com/docs/dashboard/domains/introduction
INTAKE_FROM_EMAIL=newsroom@nicksmedia.com

# Resend API key (starts with "re_"). https://resend.com/api-keys
RESEND_API_KEY=re_replace_me

# ---------------------------------------------------------------------------
# Local editorial server — used by server.py (NOT deployed to Vercel)
# ---------------------------------------------------------------------------

# Minimum 16 characters. Required to start server.py.
NICKS_ADMIN_PASSWORD=change_me_at_least_16_chars

# Minimum 32 characters. Signs the editor session cookie.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NICKS_SESSION_SECRET=change_me_at_least_32_chars_long

# Set to false only for local http:// development. Keep true in production.
NICKS_COOKIE_SECURE=true

# Optional overrides
# NICKS_HOST=127.0.0.1
# NICKS_PORT=8000
# NICKS_RETENTION_DAYS=90
# NICKS_DB_PATH=./data/reports.sqlite3
