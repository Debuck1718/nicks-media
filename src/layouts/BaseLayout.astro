---
// Shared shell: head, header, footer. Every page renders through this so the
// fonts, styles, nav and footer stay identical across the site.
export interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Set by the preview endpoint so editors see they are viewing a draft. */
  isPreview?: boolean;
  /** Absolute URL of the share image (Open Graph / Twitter cards). */
  image?: string;
  /** canonical + og:url. Defaults to the current URL. */
  canonical?: string;
  /** "article" for story pages, otherwise the site. */
  ogType?: "website" | "article";
  /** Serialisable JSON-LD object(s) injected as structured data. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  isPreview = false,
  image,
  canonical,
  ogType = "website",
  jsonLd,
} = Astro.props;

// Preview pages are per-editor and must never be indexed or canonicalised to
// the public story, so they get neither a canonical nor structured data.
const canonicalUrl =
  canonical || (noindex ? undefined : new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href);
const shareImage = image || new URL("/icon.png", Astro.site ?? Astro.url.origin).href;
const jsonLdBlocks = noindex || !jsonLd ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b2346" />
    {/* Public same-origin paths only. Never put secrets in page metadata. */}
    <meta name="report-intake-endpoint" content="/api/reports" />
    <meta name="submission-privacy-url" content="/privacy" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* Link previews: without these a story shared on WhatsApp, X or LinkedIn
        shows no headline or image at all. */}
    <meta property="og:site_name" content="Nick’s Media" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {!noindex && <meta property="og:image" content={shareImage} />}
    {!noindex && <meta property="og:image:width" content="1200" />}
    {!noindex && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {!noindex && <meta name="twitter:image" content={shareImage} />}

    <link rel="alternate" type="application/rss+xml" title="Nick’s Media — Newsroom" href="/rss.xml" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script src="/script.js" defer></script>
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, "\\u003c")} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {isPreview && (
      <div class="preview-banner" role="status">
        Draft preview — this story is not published. Only you can see it.
      </div>
    )}
    <header class="site-header" id="top">
      <a class="brand" href="/" aria-label="Nick’s Media home">
        <img src="/icon.png" alt="Nick’s Media — Inform. Inspire. Impact." width="66" height="82" />
      </a>
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open navigation"
      >
        <span></span><span></span>
      </button>
      <nav class="nav" id="primary-nav" aria-label="Main navigation">
        <a href="/#latest">Latest</a>
        <a href="/#live">Live desk</a>
        <a href="/#shows">Shows &amp; stories</a>
        <a href="/#about">About</a>
        <a href="/studio">Editorial Desk</a>
        <a class="nav-cta" href="/#contribute">Pitch a story <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <a class="brand footer-brand" href="/" aria-label="Nick’s Media home"
        ><img src="/icon.png" alt="Nick’s Media — Inform. Inspire. Impact." width="58" height="72"
      /></a>
      <span class="footer-motto">Independent journalism. Inform. Inspire. Impact.</span>
      <div class="footer-links">
        <a href="/#latest">Newsroom</a><a href="/#live">Live desk</a
        ><a href="/#shows">Shows</a><a href="/#about">About</a><a href="/privacy">Privacy</a
        ><a href="/studio" target="_blank" rel="noopener noreferrer">Editorial Studio ↗</a
        ><a href="https://www.evantradebuckman.com/" target="_blank" rel="noopener noreferrer"
          >Evantra ↗</a
        ><a href="mailto:hello@nicksmedia.com">Contact</a>
      </div>
      <span class="copyright"
        >© <span id="year">2026</span> Nick’s Media. All rights reserved.
        <span>Editorial submissions require newsroom verification before publication.</span></span
      >
    </footer>
  </body>
</html>
