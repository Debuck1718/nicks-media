---
import { timingSafeEqual } from "node:crypto";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sanityConfigured, urlFor, fileUrlFor } from "@/lib/sanity";

// Render on demand (Vercel Function) rather than pre-rendering.
//
// Why: draft preview needs to read content that did not exist at build time —
// including stories that are unpublished or brand new. A pre-rendered page
// cannot do that, so this route stays dynamic. Published stories are still fast:
// the CDN caches them normally; only ?preview= requests bypass the cache.
export const prerender = false;

const { slug } = Astro.params;

// Preview mode: /story/<slug>?preview=<PREVIEW_SECRET> reads the DRAFT instead
// of the published version. The secret is compared in constant time so a wrong
// guess cannot be distinguished from a missing one.
const previewToken = Astro.url.searchParams.get("preview") || "";
const previewSecret =
  import.meta.env.PREVIEW_SECRET ||
  (typeof process !== "undefined" ? process.env.PREVIEW_SECRET : "") ||
  "";

function secretMatches(a, b) {
  if (!a || !b) return false;
  const ab = Buffer.from(a);
  const bb = Buffer.from(b);
  return ab.length === bb.length && timingSafeEqual(ab, bb);
}

const isPreview = secretMatches(previewToken, previewSecret);

let story = null;
if (sanityConfigured) {
  try {
    const { previewClient, client: c } = await import("@/lib/sanity");
    // In preview we read drafts; otherwise only published stories.
    const draftClient = isPreview ? previewClient(previewSecret) : null;
    const usedClient = draftClient || c;
    story = await usedClient.fetch(
      /* groq */ `*[_type == "story" && slug.current == $slug && ($canPreview || !defined(publishedAt) || publishedAt <= now())][0]{
        title, "slug": slug.current, standfirst, category,
        "publishedAt": coalesce(publishedAt, _createdAt), featured,
        coverImage { asset, alt, credit },
        "author": author->{ name, role, photo { asset, alt } },
        body, seo
      }`,
      { slug, canPreview: Boolean(draftClient) },
    );
  } catch (error) {
    console.warn("Could not load story:", error.message);
  }
}

if (!story) {
  return Astro.redirect("/404");
}

const image = story.coverImage?.asset ? urlFor(story.coverImage) : null;
const title = story.seo?.metaTitle || `${story.title} — Nick’s Media`;
const description = story.seo?.metaDescription || story.standfirst;
const date = story.publishedAt
  ? new Date(story.publishedAt).toLocaleDateString("en-GB", {
      day: "numeric", month: "long", year: "numeric",
    })
  : "";

// Render Sanity portable-text blocks into plain paragraphs, headings, images, and videos.
function renderBlock(block) {
  if (block._type !== "block") return "";
  const text = (block.children || []).map((c) => c.text).join("");
  switch (block.style) {
    case "h2": return `<h2>${text}</h2>`;
    case "h3": return `<h3>${text}</h3>`;
    case "blockquote": return `<blockquote>${text}</blockquote>`;
    default: return `<p>${text}</p>`;
  }
}

function getEmbedUrl(rawUrl) {
  if (!rawUrl) return null;
  try {
    const u = new URL(rawUrl);
    // YouTube
    if (u.hostname.includes("youtube.com")) {
      const v = u.searchParams.get("v");
      if (v) return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(v)}`;
      if (u.pathname.startsWith("/embed/")) return rawUrl;
    }
    if (u.hostname.includes("youtu.be")) {
      const id = u.pathname.slice(1);
      if (id) return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}`;
    }
    // Vimeo
    if (u.hostname.includes("vimeo.com")) {
      const match = u.pathname.match(/\/(\d+)/);
      if (match) return `https://player.vimeo.com/video/${match[1]}`;
    }
  } catch {}
  return null;
}

function renderVideo(block) {
  const isUpload = block.source === "upload";
  const fileSrc = isUpload && block.file ? fileUrlFor(block.file) : null;
  const embedSrc = !isUpload && block.url ? getEmbedUrl(block.url) : null;
  const captionHtml = block.caption ? `<figcaption>${block.caption}${block.credit ? ` <span class="video-credit">(${block.credit})</span>` : ""}</figcaption>` : block.credit ? `<figcaption><span class="video-credit">${block.credit}</span></figcaption>` : "";

  if (fileSrc) {
    return `<figure class="story-video story-video-file"><video controls preload="metadata" playsinline src="${fileSrc}"></video>${captionHtml}</figure>`;
  }
  if (embedSrc) {
    return `<figure class="story-video story-video-embed"><div class="video-wrapper"><iframe src="${embedSrc}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe></div>${captionHtml}</figure>`;
  }
  return "";
}

const bodyHtml = (story.body || [])
  .map((b) => {
    if (b._type === "image" && b.asset) {
      return `<figure><img src="${urlFor(b)}" alt="${b.alt || ""}" loading="lazy" />${
        b.credit ? `<figcaption>${b.credit}</figcaption>` : ""
      }</figure>`;
    }
    if (b._type === "videoEmbed") {
      return renderVideo(b);
    }
    return renderBlock(b);
  })
  .join("");
---

<BaseLayout {title} {description} noindex={isPreview} {isPreview}>
  <article class="story-page section-pad">
    <div class="section-label">
      <span>{story.category}</span>
      {story.author?.name && <span>By {story.author.name}</span>}
    </div>
    <h1>{story.title}</h1>
    {story.standfirst && <p class="story-standfirst story-standfirst-large">{story.standfirst}</p>}
    {date && <p class="story-date"><time datetime={story.publishedAt}>{date}</time></p>}

    {image && (
      <figure class="story-lead-image">
        <img src={image} alt={story.coverImage.alt || ""} />
        {story.coverImage.credit && <figcaption>{story.coverImage.credit}</figcaption>}
      </figure>
    )}

    <div class="story-body" set:html={bodyHtml} />

    <p class="story-back">
      <a class="underlined-link" href="/">← Back to the newsroom</a>
    </p>
  </article>
</BaseLayout>
