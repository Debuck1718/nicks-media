# Secrets — never commit. Astro reads these at build time; the API routes read
# them at runtime. See .env.example for the full list of names (names only, no
# values — .env.example is committed, so it must never contain a real secret).
.env
.env.*
!.env.example

# Never commit a Studio's local env either.
studio/.env
studio/.env.*

# Node / Astro / Vercel
node_modules/
dist/
.astro/
.vercel
*.log

# OS
.DS_Store
Thumbs.db
